# ── Bot ─────────────────────────────────────────────────────────────
BOT_TOKEN=123456789:AA...your_bot_token

# ── Telegram API (from https://my.telegram.org → API Development) ──
API_ID=123456
API_HASH=your_api_hash_here

# ── MongoDB ────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
DB_NAME=session_manager

# ── Owners (comma-separated Telegram user IDs) ─────────────────────
OWNER_IDS=123456789,987654321

# ── Guard mode ─────────────────────────────────────────────────────
# How often the account is checked for new (unauthorised) logins.
GUARD_INTERVAL=5

# Length of the temporary "Allow Login" window (seconds).
ALLOW_LOGIN_SECONDS=60

# IMAP timeout used by the mail checker (seconds).
IMAP_TIMEOUT_SECONDS=15
